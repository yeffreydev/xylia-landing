---
import { SITE } from '../config';
const links = [
  { href: '/#funciones', label: 'Funciones' },
  { href: '/#desconexion', label: 'Desconexión' },
  { href: '/#precios', label: 'Precios' },
  { href: '/#faq', label: 'FAQ' },
];
---

<header class="nav">
  <div class="container inner">
    <a href="/" class="brand" aria-label={`${SITE.name} inicio`}>
      <img src="/logo.png" alt="" width="32" height="32" />
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="Principal">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="btn btn-primary cta" href={SITE.playUrl} target="_blank" rel="noopener">
      Probar gratis
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    background: rgba(7, 7, 12, 0.72);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .brand img {
    border-radius: 9px;
  }
  nav {
    display: flex;
    gap: 28px;
    margin-left: auto;
  }
  nav a {
    color: var(--text-2);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    transition: color 0.15s;
  }
  nav a:hover {
    color: var(--text);
  }
  .cta {
    height: 42px;
    padding: 0 18px;
    font-size: 14px;
  }
  @media (max-width: 760px) {
    nav {
      display: none;
    }
    .cta {
      margin-left: auto;
    }
  }
</style>
