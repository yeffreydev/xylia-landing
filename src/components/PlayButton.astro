---
import { SITE } from '../config';
interface Props {
  label?: string;
  size?: 'md' | 'lg';
}
const { label = 'Disponible en Google Play', size = 'md' } = Astro.props;
---

<a class:list={['play', size]} href={SITE.playUrl} target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <path d="M4 2.6v18.8c0 .5.6.8 1 .5l16.3-9.4a.6.6 0 0 0 0-1L5 2.1c-.4-.3-1 0-1 .5Z" fill="currentColor"></path>
  </svg>
  <span>
    <small>Descárgala gratis</small>
    {label}
  </span>
</a>

<style>
  .play {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 22px 10px 18px;
    border-radius: 16px;
    background: var(--grad);
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    box-shadow: 0 14px 44px -14px rgba(124, 92, 255, 0.9);
    transition:
      transform 0.15s ease,
      box-shadow 0.2s ease;
  }
  .play:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 56px -14px rgba(124, 92, 255, 1);
  }
  .play:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .play span {
    display: grid;
    line-height: 1.15;
    font-size: 16px;
  }
  .play small {
    font-size: 11px;
    font-weight: 600;
    opacity: 0.85;
  }
  .lg {
    padding: 14px 28px 14px 22px;
  }
  .lg span {
    font-size: 18px;
  }
</style>
