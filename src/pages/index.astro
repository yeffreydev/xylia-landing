---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PlayButton from '../components/PlayButton.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import { PLANS, SITE } from '../config';

// Feather-style line icons (stroke = currentColor).
const icons = {
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  flag: '<path d="M4 22V4M4 4h13l-2 4 2 4H4"/>',
  folder: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>',
  chart: '<path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/>',
};

const features = [
  { icon: icons.sun, title: 'Hoy', text: 'Tu objetivo principal fijado arriba, tus tareas del día y una barra de progreso que se llena contigo.' },
  { icon: icons.flag, title: 'Objetivos', text: 'Metas para esta semana, este mes o este año. Marca cada día si cumpliste y mira tu constancia.' },
  { icon: icons.folder, title: 'Proyectos', text: 'Agrupa objetivos y tareas bajo un mismo proyecto y ve cuánto llevas de cada uno.' },
  { icon: icons.calendar, title: 'Calendario', text: 'Tareas diarias, semanales o de una vez. Todo tu mes de un vistazo, día por día.' },
  { icon: icons.moon, title: 'Desconexión', text: 'Sesiones sin móvil con sonido ambiental. Si sales de la pantalla, la sesión falla. Sin trampas.' },
  { icon: icons.chart, title: 'Reportes', text: 'Rachas, % de cumplimiento, sesiones exitosas y fallidas. Tu disciplina en números.' },
];

const steps = [
  { n: '01', title: 'Empieza tu prueba', text: 'Instala Xylia desde Google Play y activa tus 7 días gratis en un toque.' },
  { n: '02', title: 'Define tu día', text: 'Fija tu objetivo principal y crea las tareas que te acercan a él.' },
  { n: '03', title: 'Cumple y desconecta', text: 'Marca tus tareas, haz sesiones de desconexión y mira crecer tu racha.' },
];

const faqs = [
  { q: '¿Cómo funciona la prueba gratis?', a: 'Tienes 7 días con acceso completo sin pagar nada. Si no cancelas antes de que terminen, Google Play cobra el plan que elegiste cada mes.' },
  { q: '¿Cómo cancelo?', a: 'Desde Google Play → Pagos y suscripciones → Suscripciones → Xylia → Cancelar. También desde la app en Perfil → Planes y suscripción. Si cancelas durante la prueba no se te cobra nada.' },
  { q: '¿Qué pasa si salgo de la app durante una desconexión?', a: 'La sesión se registra como fallida. Solo cuentan como exitosas las sesiones en las que te quedas en la pantalla hasta el final. Puedes silenciar el sonido; la pantalla se mantiene encendida.' },
  { q: '¿Puedo cambiar de Básico a Pro?', a: 'Sí, cuando quieras desde la app. Google Play ajusta el cobro proporcionalmente.' },
  { q: '¿Está disponible en iPhone?', a: 'Por ahora Xylia está disponible en Android a través de Google Play.' },
  { q: '¿Qué hacen con mis datos?', a: 'Solo guardamos lo necesario para que la app funcione. No vendemos tus datos. Puedes eliminar tu cuenta y todos tus datos desde la app en cualquier momento.' },
];
---

<Base>
  <Nav />

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="glow g1"></div>
      <div class="glow g2"></div>
      <div class="container hero-grid">
        <div class="hero-copy" data-reveal>
          <span class="eyebrow">✦ 7 días gratis</span>
          <h1>
            Disciplina diaria<br />que <span class="grad-text">sí se queda.</span>
          </h1>
          <p class="lead">
            Hábitos, objetivos y proyectos en un solo lugar. Y un modo
            <strong>Desconexión</strong> que te mantiene lejos del móvil de verdad.
          </p>
          <div class="hero-cta">
            <PlayButton size="lg" />
            <a class="btn btn-ghost" href="#precios">Ver planes</a>
          </div>
          <ul class="trust">
            <li>✓ Cancela cuando quieras</li>
            <li>✓ Sin anuncios</li>
            <li>✓ Desde US$3/mes</li>
          </ul>
        </div>
        <div class="hero-visual" data-reveal>
          <div class="chip c1">🔥 Racha de 12 días</div>
          <div class="chip c2">✓ 92% cumplido</div>
          <PhoneMockup />
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="section" id="funciones">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">Funciones</span>
          <h2>Todo lo que necesitas para <span class="grad-text">cumplir</span></h2>
          <p>Sin ruido. Sin mil pantallas. Solo lo que te ayuda a hacer lo que dijiste que harías.</p>
        </div>
        <div class="features">
          {
            features.map((f, i) => (
              <article class="card feature" data-reveal style={`transition-delay:${i * 60}ms`}>
                <span class="f-icon">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
                </span>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- DISCONNECT SPOTLIGHT -->
    <section class="section spotlight" id="desconexion">
      <div class="container spot-grid">
        <div class="rings-wrap" data-reveal aria-hidden="true">
          <div class="rings">
            <span></span><span></span><span></span>
            <div class="core">
              <b>24:59</b>
              <small class="breath"></small>
            </div>
            <svg class="arc" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="46" pathLength="100"></circle>
            </svg>
          </div>
        </div>
        <div data-reveal>
          <span class="eyebrow">Modo Desconexión</span>
          <h2 class="spot-title">Como darle play a la música.<br /><span class="grad-text">Pero para tu mente.</span></h2>
          <p class="spot-lead">
            Elige cuánto tiempo, dale play y deja el móvil. Suena un ambiente suave
            (o en silencio) y la pantalla se queda encendida con una animación de respiración.
          </p>
          <ul class="checks">
            <li><b>Sin trampas:</b> si sales de la app o apagas la pantalla, la sesión falla.</li>
            <li><b>Silencia el sonido</b> cuando quieras; la pantalla sigue encendida.</li>
            <li><b>Todo queda registrado:</b> sesiones exitosas, fallidas y minutos desconectado.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- HOW -->
    <section class="section">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">Cómo funciona</span>
          <h2>Tres pasos. Todos los días.</h2>
        </div>
        <div class="steps">
          {
            steps.map((s) => (
              <div class="step" data-reveal>
                <span class="n grad-text">{s.n}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section class="section" id="precios">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">Precios</span>
          <h2>Empieza con <span class="grad-text">7 días gratis</span></h2>
          <p>Elige tu plan. Paga solo si te quedas. Cancela cuando quieras desde Google Play.</p>
        </div>
        <div class="plans">
          {
            PLANS.map((p) => (
              <article class:list={['card', 'plan', { hl: p.highlight }]} data-reveal>
                {p.highlight && <span class="badge">Más popular</span>}
                <h3>{p.name}</h3>
                <p class="blurb">{p.blurb}</p>
                <p class="price">
                  <span class="cur">US$</span>
                  <span class="amt">{p.price}</span>
                  <span class="per">/mes</span>
                </p>
                <p class="trial">7 días gratis, luego US${p.price}/mes</p>
                <ul>
                  {p.features.map((f) => <li>{f}</li>)}
                </ul>
                <a class:list={['btn', p.highlight ? 'btn-primary' : 'btn-ghost']} href={SITE.playUrl} target="_blank" rel="noopener">
                  Empezar prueba gratis
                </a>
              </article>
            ))
          }
        </div>
        <p class="fine">
          Precios en dólares estadounidenses; Google Play muestra el precio en tu moneda local.
          La suscripción se renueva automáticamente cada mes hasta que la canceles.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" id="faq">
      <div class="container narrow">
        <div class="section-head" data-reveal>
          <span class="eyebrow">FAQ</span>
          <h2>Preguntas frecuentes</h2>
        </div>
        <div class="faq">
          {
            faqs.map((f) => (
              <details class="card" data-reveal>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="section">
      <div class="container">
        <div class="final" data-reveal>
          <img src="/logo.png" alt="" width="72" height="72" />
          <h2>Tu mejor versión empieza hoy.</h2>
          <p>7 días gratis. Sin compromiso.</p>
          <PlayButton size="lg" />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* HERO */
  .hero {
    position: relative;
    padding: 72px 0 96px;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
  }
  .g1 {
    width: 520px;
    height: 520px;
    background: rgba(124, 92, 255, 0.35);
    top: -160px;
    right: -120px;
  }
  .g2 {
    width: 420px;
    height: 420px;
    background: rgba(185, 166, 255, 0.16);
    bottom: -200px;
    left: -140px;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
  }
  .hero-copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  h1 {
    font-size: clamp(42px, 7vw, 76px);
    font-weight: 800;
    letter-spacing: -0.045em;
  }
  .lead {
    font-size: clamp(17px, 2vw, 20px);
    color: var(--text-2);
    max-width: 520px;
  }
  .lead strong {
    color: var(--text);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  .trust {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    color: var(--text-3);
    font-size: 14px;
    font-weight: 600;
  }
  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
  }
  .chip {
    position: absolute;
    z-index: 3;
    padding: 10px 14px;
    border-radius: 14px;
    background: rgba(28, 28, 37, 0.85);
    border: 1px solid var(--border-strong);
    backdrop-filter: blur(10px);
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.8);
    animation: bob 5s ease-in-out infinite;
  }
  .c1 {
    top: 18%;
    left: -2%;
  }
  .c2 {
    bottom: 16%;
    right: 0;
    animation-delay: -2.5s;
    color: var(--success);
  }
  @keyframes bob {
    50% {
      transform: translateY(-10px);
    }
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .hero {
      padding-top: 48px;
    }
    .c1 {
      left: 0;
    }
  }

  /* FEATURES */
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .feature {
    padding: 28px;
    display: grid;
    gap: 12px;
    align-content: start;
    transition:
      border-color 0.2s,
      transform 0.2s,
      opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .feature:hover {
    border-color: rgba(167, 139, 255, 0.4);
    transform: translateY(-4px);
  }
  .f-icon {
    width: 46px;
    height: 46px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: rgba(124, 92, 255, 0.14);
    color: var(--primary-soft);
  }
  .feature h3 {
    font-size: 20px;
  }
  .feature p {
    color: var(--text-2);
  }
  @media (max-width: 900px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .features {
      grid-template-columns: 1fr;
    }
  }

  /* SPOTLIGHT */
  .spotlight {
    background:
      radial-gradient(60% 80% at 20% 50%, rgba(124, 92, 255, 0.16), transparent 70%),
      var(--bg-elev);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .spot-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 56px;
    align-items: center;
  }
  .spot-title {
    font-size: clamp(30px, 4.5vw, 46px);
    margin: 16px 0;
  }
  .spot-lead {
    color: var(--text-2);
    font-size: 18px;
  }
  .checks {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    gap: 14px;
  }
  .checks li {
    position: relative;
    padding-left: 34px;
    color: var(--text-2);
  }
  .checks li b {
    color: var(--text);
  }
  .checks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 1px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--grad);
    color: #fff;
    font-size: 12px;
    font-weight: 900;
    display: grid;
    place-items: center;
  }
  .rings-wrap {
    display: grid;
    place-items: center;
  }
  .rings {
    position: relative;
    width: min(360px, 80vw);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .rings span {
    position: absolute;
    inset: 22%;
    border-radius: 50%;
    border: 2px solid var(--primary-soft);
    animation: ripple 4s linear infinite;
    opacity: 0;
  }
  .rings span:nth-child(2) {
    animation-delay: -1.33s;
  }
  .rings span:nth-child(3) {
    animation-delay: -2.66s;
  }
  @keyframes ripple {
    0% {
      transform: scale(1);
      opacity: 0.45;
    }
    100% {
      transform: scale(2.1);
      opacity: 0;
    }
  }
  .core {
    position: relative;
    width: 56%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 92, 255, 0.6), rgba(91, 63, 217, 0.06) 70%);
    display: grid;
    place-content: center;
    text-align: center;
    animation: breathe 10s ease-in-out infinite;
  }
  .core b {
    font-size: clamp(34px, 7vw, 48px);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .breath::before {
    content: 'Inhala';
    color: var(--text-2);
    font-size: 15px;
    animation: breath-word 10s steps(1) infinite;
  }
  @keyframes breath-word {
    50% {
      content: 'Exhala';
    }
  }
  @keyframes breathe {
    0%,
    100% {
      transform: scale(0.92);
    }
    50% {
      transform: scale(1.08);
    }
  }
  .arc {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
  }
  .arc circle {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 100;
    animation: arc 12s linear infinite;
  }
  @keyframes arc {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (max-width: 900px) {
    .spot-grid {
      grid-template-columns: 1fr;
    }
  }

  /* STEPS */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .step {
    padding: 28px;
    border-left: 2px solid var(--border);
    display: grid;
    gap: 10px;
  }
  .n {
    font-size: 44px;
    font-weight: 800;
    line-height: 1;
  }
  .step h3 {
    font-size: 20px;
  }
  .step p {
    color: var(--text-2);
  }
  @media (max-width: 800px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  /* PRICING */
  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 400px));
    justify-content: center;
    gap: 24px;
  }
  .plan {
    position: relative;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .plan.hl {
    border: 2px solid var(--primary-soft);
    background:
      linear-gradient(160deg, rgba(124, 92, 255, 0.22), rgba(91, 63, 217, 0.04)),
      var(--surface);
    box-shadow: 0 30px 80px -30px rgba(124, 92, 255, 0.7);
  }
  .badge {
    position: absolute;
    top: -13px;
    left: 32px;
    background: var(--grad);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 999px;
  }
  .plan h3 {
    font-size: 24px;
  }
  .blurb {
    color: var(--text-2);
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-top: 8px;
  }
  .cur {
    color: var(--text-2);
    font-weight: 700;
  }
  .amt {
    font-size: 60px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .per {
    color: var(--text-3);
  }
  .trial {
    color: var(--success);
    font-weight: 700;
    font-size: 14px;
  }
  .plan ul {
    list-style: none;
    padding: 0;
    margin: 8px 0 16px;
    display: grid;
    gap: 10px;
    flex: 1;
  }
  .plan li {
    padding-left: 28px;
    position: relative;
  }
  .plan li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--primary-soft);
    font-weight: 900;
  }
  .plan .btn {
    width: 100%;
  }
  .fine {
    text-align: center;
    color: var(--text-3);
    font-size: 13px;
    max-width: 560px;
    margin: 32px auto 0;
  }
  @media (max-width: 760px) {
    .plans {
      grid-template-columns: 1fr;
    }
  }

  /* FAQ */
  .narrow {
    max-width: 780px;
  }
  .faq {
    display: grid;
    gap: 12px;
  }
  details {
    padding: 0;
    overflow: hidden;
  }
  summary {
    cursor: pointer;
    list-style: none;
    padding: 20px 56px 20px 24px;
    font-weight: 700;
    font-size: 17px;
    position: relative;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    position: absolute;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 24px;
    color: var(--primary-soft);
    transition: transform 0.2s;
  }
  details[open] summary::after {
    transform: translateY(-50%) rotate(45deg);
  }
  details p {
    padding: 0 24px 22px;
    color: var(--text-2);
  }

  /* FINAL */
  .final {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 16px;
    padding: 64px 24px;
    border-radius: 32px;
    background:
      radial-gradient(80% 120% at 50% 0%, rgba(124, 92, 255, 0.35), transparent 70%),
      var(--surface);
    border: 1px solid var(--border);
  }
  .final img {
    border-radius: 18px;
    box-shadow: 0 20px 60px -10px rgba(124, 92, 255, 0.7);
  }
  .final h2 {
    font-size: clamp(30px, 5vw, 48px);
  }
  .final p {
    color: var(--text-2);
    font-size: 18px;
    margin-bottom: 8px;
  }
</style>
